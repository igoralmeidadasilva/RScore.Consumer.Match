{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    },
    "WriteTo:1": {
      "Name": "OpenTelemetry",
      "Args": {
        "endpoint": "http://localhost:4317"
      }
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=rscore;Username=postgres;Password=postgres;Include Error Detail=true;"
  },
  "KafkaOptions": {
    "Host": "localhost:9092",
    "MatchEventsTopic": "match-events",
    "MatchEventsConsumerGroup": "match-events-consumer-group"
  },
  "OpenTelemetryOptions": {
    "Endpoint": "http://localhost:4317"
  }
}
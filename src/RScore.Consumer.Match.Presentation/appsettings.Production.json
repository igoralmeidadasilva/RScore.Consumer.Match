{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    },
    "WriteTo:1": {
      "Name": "OpenTelemetry",
      "Args": {
        "endpoint": "__OTEL_EXPORTER_OTLP_ENDPOINT__"
      }
    }
  },
  "ConnectionStrings": {
    "Postgres": "__POSTGRES_CONNECTION_STRING__"
  },
  "KafkaOptions": {
    "Host": "__KAFKA_HOST__",
    "MatchEventsTopic": "match-events",
    "MatchEventsConsumerGroup": "match-events-consumer-group"
  }
}